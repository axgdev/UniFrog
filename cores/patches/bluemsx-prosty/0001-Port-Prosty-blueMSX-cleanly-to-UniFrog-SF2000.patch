 #endif
diff --git a/Src/SoundChips/OpenMsxYM2413.cpp b/Src/SoundChips/OpenMsxYM2413.cpp
index 416d3badfc34dbe0dfaa2218d66eb8387f390c91..f5a7c405a537df87af21f211e883f9f2b764acf6 100644
--- a/Src/SoundChips/OpenMsxYM2413.cpp
+++ b/Src/SoundChips/OpenMsxYM2413.cpp
@@ -304,7 +304,7 @@ static const UINT8 lfo_am_table[LFO_AM_TAB_ELEMENTS] =
 };
 
 // LFO Phase Modulation table (verified on real YM2413)
-static const char lfo_pm_table[8 * 8] = 
+static const signed char lfo_pm_table[8 * 8] = 
 {
 	// FNUM2/FNUM = 0 00xxxxxx (0x0000)
 	0, 0, 0, 0, 0, 0, 0, 0,

