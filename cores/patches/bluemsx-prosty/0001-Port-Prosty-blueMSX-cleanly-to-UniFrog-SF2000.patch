index 89d3b4db1e01c6e2432220ff4f74f63ffd223ebe..a69637baa7588a6b1bc2b088f026bbc41e149794 100644
--- a/Src/Memory/romMapperActivisionPcb.c
+++ b/Src/Memory/romMapperActivisionPcb.c
@@ -230,4 +230,3 @@ int romMapperActivisionPcbCreate(const char* filename, int romType, UInt8* romDa
 
     return 1;
 }
