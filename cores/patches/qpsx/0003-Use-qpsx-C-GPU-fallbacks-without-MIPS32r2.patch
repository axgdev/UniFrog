From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Axel Garcia K." <git@axelgk.com>
Date: Tue, 5 May 2026 18:57:45 +0000
Subject: [PATCH 03/11] Use qpsx C GPU fallbacks without MIPS32r2

Route GPU helper macros to the C fallback implementations unless QPSX_ENABLE_MIPS32R2 is enabled, preventing illegal instructions on base MIPS32 SF2000 devices.
---
 src/gpu/gpu_unai/gpu_inner_mips32.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/gpu/gpu_unai/gpu_inner_mips32.h b/src/gpu/gpu_unai/gpu_inner_mips32.h
index eca1ff76add89992b1677ccad15f84776b2e5ef8..73d62a4f683b2c92a72a94580af4d27491bca718 100644
--- a/src/gpu/gpu_unai/gpu_inner_mips32.h
+++ b/src/gpu/gpu_unai/gpu_inner_mips32.h
@@ -22,7 +22,7 @@
  * When disabled, falls back to C implementations.
  */
 
-#if defined(SF2000) || defined(__mips__)
+#if defined(QPSX_ENABLE_MIPS32R2) && QPSX_ENABLE_MIPS32R2
 
 #ifdef __cplusplus
 extern "C" {
@@ -120,7 +120,7 @@ static inline u16 gpuBlending_ASM(u16 uSrc, u16 uDst)
     return uSrc;
 }
 
-#else /* !SF2000 && !__mips__ */
+#else /* !QPSX_ENABLE_MIPS32R2 */
 
 /* Fallback stubs for non-MIPS platforms (compilation only) */
 #define gpuLightingTXT_ASM(uSrc, r5, g5, b5)     gpuLightingTXT_Fast(uSrc, r5, g5, b5)
@@ -137,6 +137,6 @@ static inline u16 gpuBlending_ASM(u16 uSrc, u16 uDst)
     return gpuBlending_Fast<BLENDMODE>(uSrc, uDst);
 }
 
-#endif /* SF2000 || __mips__ */
+#endif /* QPSX_ENABLE_MIPS32R2 */
 
 #endif /* GPU_INNER_MIPS32_H */
-- 
