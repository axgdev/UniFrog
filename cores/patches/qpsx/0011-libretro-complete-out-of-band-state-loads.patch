From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Axel Garcia K." <git@axelgk.com>
Date: Mon, 10 Aug 2026 10:33:39 +0100
Subject: [PATCH 11/11] libretro: complete out-of-band state loads

Clear the recursive-load counter guard after a successful paused libretro restore while preserving native in-VBlank semantics.

Evidence: this is the previously reviewed frontend patch qpsx-libretro-resume-context.patch, applied in its established build order on upstream 368310a.

Risk: limited to the paths recorded in that patch. Reverting this commit restores the preceding independently buildable checkpoint.
---
 libretro/core/libretro-core.cpp | 2 ++
 src/psxcounters.cpp             | 5 +++++
 src/psxcounters.h               | 1 +
 3 files changed, 8 insertions(+)

diff --git a/libretro/core/libretro-core.cpp b/libretro/core/libretro-core.cpp
index 2a4285d4a8ecace411a83b550661126b050ab396..2a08a18406138615950bb86f00b411d42e9462f7 100644
--- a/libretro/core/libretro-core.cpp
+++ b/libretro/core/libretro-core.cpp
@@ -4102,6 +4102,8 @@ static int mem_state_run_load(const unsigned char *data, unsigned long capacity)
   SaveFuncs = mem_state_funcs();
   result = LoadState("");
   SaveFuncs = saved;
+  if (result == 0)
+    psxRcntCompleteExternalFreeze();
   return result;
 }
 
diff --git a/src/psxcounters.cpp b/src/psxcounters.cpp
index 8ab6460cf3cea57ba75a6f58fad345a5b9f36058..5f94f88de190b6c2df64c41c98057963b9c69a55 100644
--- a/src/psxcounters.cpp
+++ b/src/psxcounters.cpp
@@ -618,6 +618,11 @@ void psxRcntInitFromFreeze(void)
 	rcntFreezeLoaded = true;
 }
 
+void psxRcntCompleteExternalFreeze(void)
+{
+	rcntFreezeLoaded = false;
+}
+
 /******************************************************************************/
 // Called before psxRegs.cycle is adjusted back to zero
 //  by PSXINT_RESET_CYCLE_VAL event in psxevents.cpp
diff --git a/src/psxcounters.h b/src/psxcounters.h
index 60587c99bbe7ae94c68665c4752377894cfa13c0..e242e9dd67528a1125ecb1f217cb3278063890f6 100644
--- a/src/psxcounters.h
+++ b/src/psxcounters.h
@@ -53,6 +53,7 @@ u32 psxRcntRtarget(u32 index);
 
 int psxRcntFreeze(void* f, FreezeMode mode);
 void psxRcntInitFromFreeze(void);
+void psxRcntCompleteExternalFreeze(void);
 
 void psxRcntAdjustTimestamps(const uint32_t prev_cycle_val);
 
-- 
2.43.0

