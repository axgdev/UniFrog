--- a/cpu_threaded.c
+++ b/cpu_threaded.c
@@ -2657,13 +2657,15 @@ u8 function_cc *block_lookup_address_arm(u32 pc)
   unsigned i;
   for (i = 0; i < 2; i++) {
     u8 *ret = block_lookup_translate_arm(pc);
-    if (ret) {
+    if (ret && ret != (u8 *)(~0)) {
       translate_icache_sync();
