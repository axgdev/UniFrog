   return NULL;
 }
 
@@ -2672,12 +2674,14 @@ u8 function_cc *block_lookup_address_thumb(u32 pc)
   unsigned i;
   for (i = 0; i < 2; i++) {
     u8 *ret = block_lookup_translate_thumb(pc);
-    if (ret) {
