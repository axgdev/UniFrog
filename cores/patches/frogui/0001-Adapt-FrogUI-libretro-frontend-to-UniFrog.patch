 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <unifrog/paths.h>
 
 static stbtt_fontinfo font_info;
 static unsigned char *font_buffer = NULL;
 static float font_scale;
 static int font_loaded = 0;
+static int font_baseline;
+
+typedef struct {
+    unsigned char *bitmap;
+    int width;
+    int height;
+    int xoff;
+    int yoff;
+    int advance;
+    int valid;
+} CachedGlyph;
+
+static CachedGlyph glyph_cache[128];
 
 #ifndef UI_SCALE
 #define UI_SCALE 100
 #endif
 #define FONT_SIZE (20.0f * UI_SCALE / 100.0f)
 
+static void clear_glyph_cache(void) {
+    for (unsigned i = 0; i < sizeof(glyph_cache) / sizeof(glyph_cache[0]); i++) {
+        if (glyph_cache[i].bitmap)
+            stbtt_FreeBitmap(glyph_cache[i].bitmap, NULL);
+    }
+    memset(glyph_cache, 0, sizeof(glyph_cache));
+}
+
+static CachedGlyph *get_glyph(unsigned char code) {
+    CachedGlyph *cached;
+    int glyph_index;
+    int advance_width;
+    int left_side_bearing;
+
+    if (code >= sizeof(glyph_cache)) return NULL;
+    if (code >= 'a' && code <= 'z') code = (unsigned char)(code - 'a' + 'A');
+    cached = &glyph_cache[code];
+    if (cached->valid) return cached;
+    cached->valid = 1;
+    glyph_index = stbtt_FindGlyphIndex(&font_info, code);
+    if (!glyph_index) {
+        cached->advance = FONT_CHAR_SPACING;
+        return cached;
+    }
+    stbtt_GetGlyphHMetrics(&font_info, glyph_index, &advance_width,
+                           &left_side_bearing);
+    cached->advance = (int)(advance_width * font_scale);
+    cached->bitmap = stbtt_GetGlyphBitmap(&font_info, 0, font_scale,
+                                           glyph_index, &cached->width,
+                                           &cached->height, &cached->xoff,
+                                           &cached->yoff);
+    return cached;
+}
+
 // Internal function to load a font file
 static int load_font_file(const char *font_filename) {
+    clear_glyph_cache();
     // Free previous font if loaded
     if (font_buffer) {
         free(font_buffer);
@@ -25,15 +74,13 @@ static int load_font_file(const char *font_filename) {
         font_loaded = 0;
     }
 
-    // Build search paths for the font (SF3000 paths first)
