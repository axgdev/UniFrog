-    snprintf(font_paths[1], sizeof(font_paths[1]), "/mnt/sdcard/frogui/fonts/%s", font_filename);
-    snprintf(font_paths[2], sizeof(font_paths[2]), "/mnt/sda1/frogui/fonts/%s", font_filename);
-    snprintf(font_paths[3], sizeof(font_paths[3]), "fonts/%s", font_filename);
+    // UniFrog packages defaults here and users may replace either font.
+    char font_paths[2][256];
+    snprintf(font_paths[0], sizeof(font_paths[0]), UNIFROG_DATA_ROOT "/frogui/fonts/%s", font_filename);
+    snprintf(font_paths[1], sizeof(font_paths[1]), UNIFROG_DIST_ROOT "/frogui/fonts/%s", font_filename);
 
     FILE *fp = NULL;
-    for (int i = 0; i < 4; i++) {
