 #ifdef TRACE_REGISTERS
diff --git a/mips/mips_emit.h b/mips/mips_emit.h
index 2ce520d..dc22de3 100644
--- a/mips/mips_emit.h
+++ b/mips/mips_emit.h
@@ -2653,13 +2653,16 @@ static void emit_phand(
   mips_emit_addu(reg_temp, reg_temp, reg_base); // Add to the base_reg the table offset
   mips_emit_lw(reg_rv,   reg_temp, tbloff);     // Get func addr from 1st table
   mips_emit_lw(reg_temp, reg_temp, tbloff2);    // Get opcode from 2nd table
-  mips_emit_sw(reg_temp, mips_reg_ra, -8);      // Patch instruction!
-
   #if defined(PSP)
+    mips_emit_sw(reg_temp, mips_reg_ra, -8);    // Patch instruction!
     mips_emit_cache(0x1A, mips_reg_ra, -8);
     mips_emit_jr(reg_rv);                       // Jump directly to target for speed
     mips_emit_cache(0x08, mips_reg_ra, -8);
+  #elif defined(SF2000)
+    mips_emit_jr(reg_rv);                       // Jump directly to target for speed
+    mips_emit_nop();
   #else
+    mips_emit_sw(reg_temp, mips_reg_ra, -8);    // Patch instruction!
     mips_emit_jr(reg_rv);
     #ifdef MIPS_HAS_R2_INSTS
       mips_emit_synci(mips_reg_ra, -8);
@@ -2803,7 +2806,15 @@ void init_emitter(bool must_swap) {
 
 u32 execute_arm_translate_internal(u32 cycles, void *regptr);
 u32 execute_arm_translate(u32 cycles) {
-  return execute_arm_translate_internal(cycles, &reg[0]);
+  u32 ret = execute_arm_translate_internal(cycles, &reg[0]);
+#ifdef SF2000
+  if (ret == SF2000_GPSP_DYNAREC_LOOKUP_FAILED) {
+    clear_gamepak_stickybits();
+    execute_arm(cycles);
+    return 0;
+  }
+#endif
+  return ret;
 }
 
 #endif
diff --git a/mips/mips_stub.S b/mips/mips_stub.S
index 34b0446..9b6bb77 100644
--- a/mips/mips_stub.S
+++ b/mips/mips_stub.S
@@ -18,17 +18,24 @@
 
 #include "../gpsp_config.h"
 
+#define SF2000_GPSP_DYNAREC_LOOKUP_FAILED 0x7ffffffe
+
 // This is also defined in sys/asm.h but doesn't seem portable?
 #ifdef __mips64
   .set mips64
   #define SZREG 8
   #define REG_L ld
   #define REG_S sd
-#else
+#elif defined(MIPS_HAS_R2_INSTS)
   .set mips32r2
   #define SZREG 4
   #define REG_L lw
   #define REG_S sw
+#else
+  .set mips32
+  #define SZREG 4
+  #define REG_L lw
+  #define REG_S sw
 #endif
 
 #define defsymbl(symbol) \
@@ -227,6 +234,14 @@ symbol:
 .endm
 #endif
 
+.macro jump_translated_result
+  beqz $2, translated_lookup_failed
+  addiu $1, $0, -4
+  and $2, $2, $1
+  jr $2
+  nop
+.endm
+
 
 # Process a hardware event. Since an interrupt might be
 # raised we have to check if the PC has changed.
@@ -298,22 +313,26 @@ defsymbl(mips_indirect_branch_arm)
   save_registers
   cfncall block_lookup_address_arm, 1
   restore_registers
-  jr $2                           # $2 = value returned
-  nop
+  jump_translated_result          # $2 = value returned
 
 defsymbl(mips_indirect_branch_thumb)
   save_registers
   cfncall block_lookup_address_thumb, 2
   restore_registers
-  jr $2                           # $2 = value returned
-  nop
+  jump_translated_result          # $2 = value returned
 
 defsymbl(mips_indirect_branch_dual)
   save_registers
   cfncall block_lookup_address_dual, 3
   nop
   restore_registers
-  jr $2                           # $2 = value returned
+  jump_translated_result          # $2 = value returned
+
+translated_lookup_failed:
+  collapse_flags
+  save_registers
+  li $2, SF2000_GPSP_DYNAREC_LOOKUP_FAILED
+  b return_to_main
   nop
 
 
@@ -359,13 +378,11 @@ lookup_pc_noflags:
 
   cfncall block_lookup_address_thumb, 2  # get Thumb address
   restore_registers
-  jr $2                                  # jump to result
-  nop
+  jump_translated_result                 # jump to result
 1:
   cfncall block_lookup_address_arm, 1  # get ARM address
   restore_registers
-  jr $2                                # jump to result
-  nop
+  jump_translated_result               # jump to result
 
 
 defsymbl(smc_write)
@@ -485,8 +502,7 @@ defsymbl(execute_store_cpsr)
   addu $4, $2, $0                      # load new address in $4
   cfncall block_lookup_address_arm, 1  # GBA address is in $4
   restore_registers                    # restore registers
-  jr $2                                # jump to the new address
-  nop
+  jump_translated_result               # jump to the new address
 
 
 # $4: new spsr
@@ -542,14 +558,12 @@ defsymbl(execute_arm_translate_internal)
 
   cfncall block_lookup_address_arm, 1
   restore_registers               # load initial register values
-  jr $2                           # jump to return
-  nop
+  jump_translated_result          # jump to return
 
 1:
   cfncall block_lookup_address_thumb, 2
   restore_registers               # load initial register values
-  jr $2                           # jump to return
-  nop
+  jump_translated_result          # jump to return
 
