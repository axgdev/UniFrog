From 07b47b5e31f21f52769fc1d0c2a2c5758e30472a Mon Sep 17 00:00:00 2001
From: "Axel Garcia K." <git@axelgk.com>
Date: Tue, 5 May 2026 18:57:43 +0000
Subject: [PATCH 1/2] Add SF2000 gpSP dynarec safety hooks

Guard dynarec memory-handler callsite patching so only aligned instructions inside the ROM and RAM translation caches are modified, then flush the instruction cache through the UniFrog helper. Add low-frequency load progress callbacks for long ROM and reset stages.
---
 common.h            | 10 +++++++
 cpu_threaded.c      | 10 +++++--
 gba_memory.c        | 68 ++++++++++++++++++++++++++++++++++++++++++++-
 libretro/libretro.c | 11 ++++++++
 main.c              |  5 ++++
 mips/mips_emit.h    | 17 ++++++++++--
 mips/mips_stub.S    | 46 +++++++++++++++++++-----------
 7 files changed, 145 insertions(+), 22 deletions(-)

diff --git a/common.h b/common.h
index ea0854b..0d70d00 100644
--- a/common.h
+++ b/common.h
@@ -78,6 +78,16 @@
   typedef signed long long int s64;
 #endif
 
+#ifdef SF2000
+#define SF2000_GPSP_DYNAREC_LOOKUP_FAILED 0x7ffffffeu
+void unifrog_core_load_progress(const char *stage, unsigned current,
+  unsigned total);
+#define sf2000_load_progress(stage, current, total) \
+  unifrog_core_load_progress((stage), (unsigned)(current), (unsigned)(total))
+#else
+#define sf2000_load_progress(stage, current, total) ((void)0)
+#endif
+
 #if defined(USE_XBGR1555_FORMAT)
   #define convert_palette(value)  \
     (value & 0x7FFF)
diff --git a/cpu_threaded.c b/cpu_threaded.c
index f491670..cdeac92 100644
--- a/cpu_threaded.c
+++ b/cpu_threaded.c
@@ -2653,12 +2653,15 @@ u8 function_cc *block_lookup_address_arm(u32 pc)
   unsigned i;
   for (i = 0; i < 4; i++) {
     u8 *ret = block_lookup_translate_arm(pc);
-    if (ret) {
+    if (ret && ret != (u8 *)(~0)) {
       translate_icache_sync();
       return ret;
     }
+    if (ret == (u8 *)(~0))
+      break;
   }
 
+  reg[REG_PC] = pc;
   printf("bad jump %x (%x)\n", pc, reg[REG_PC]);
   fflush(stdout);
   return NULL;
@@ -2669,11 +2672,14 @@ u8 function_cc *block_lookup_address_thumb(u32 pc)
   unsigned i;
   for (i = 0; i < 4; i++) {
     u8 *ret = block_lookup_translate_thumb(pc);
-    if (ret) {
+    if (ret && ret != (u8 *)(~0)) {
       translate_icache_sync();
       return ret;
     }
+    if (ret == (u8 *)(~0))
+      break;
   }
+  reg[REG_PC] = pc;
   printf("bad jump %x (%x)\n", pc, reg[REG_PC]);
   fflush(stdout);
   return NULL;
diff --git a/gba_memory.c b/gba_memory.c
index 68c3831..00f8004 100644
--- a/gba_memory.c
+++ b/gba_memory.c
@@ -2512,12 +2512,14 @@ static s32 load_gamepak_raw(const char *name)
 
     // Unmap the ROM space since we will re-map it now
     map_null(read, 0x8000000, 0xD000000);
+    sf2000_load_progress("ROM", 0, ldblks);
 
     // Proceed to read the whole ROM or as much as possible.
     for (i = 0; i < ldblks; i++)
     {
       // Load 1MB chunk and map it
       filestream_read(gamepak_file_large, gamepak_buffers[i], gamepak_buffer_blocksize);
+      sf2000_load_progress("ROM", i + 1, ldblks);
       for (j = 0; j < 32 && i*32 + j < rom_blocks; j++)
       {
         u32 phyn = i*32 + j;
@@ -2535,12 +2537,74 @@ static s32 load_gamepak_raw(const char *name)
   return -1;
 }
 
+static s32 load_gamepak_memory(const struct retro_game_info *info)
+{
+  unsigned i, j;
+  const u8 *rom = (const u8 *)info->data;
+  u32 source_size = (u32)info->size;
+  u32 buf_blocks;
+  u32 rom_blocks;
+
+  if (!rom || source_size == 0)
+    return -1;
+
+  // Round size to 32KB pages
+  gamepak_size = (source_size + 0x7FFF) & ~0x7FFF;
+  buf_blocks = (gamepak_size + gamepak_buffer_blocksize - 1) /
+    gamepak_buffer_blocksize;
+  rom_blocks = gamepak_size >> 15;
+
+  if (buf_blocks > gamepak_buffer_count)
+    return -1;
+
+  if (gamepak_file_large)
+  {
+    filestream_close(gamepak_file_large);
+    gamepak_file_large = NULL;
+  }
+
+  // Unmap the ROM space since we will re-map it now
+  map_null(read, 0x8000000, 0xD000000);
+  sf2000_load_progress("ROM_MEM", 0, buf_blocks);
+
+  for (i = 0; i < buf_blocks; i++)
+  {
+    size_t src_offset = (size_t)i * gamepak_buffer_blocksize;
+    size_t copy_size = source_size > src_offset ?
+      source_size - src_offset : 0;
+
+    if (copy_size > gamepak_buffer_blocksize)
+      copy_size = gamepak_buffer_blocksize;
+    memset(gamepak_buffers[i], 0xff, gamepak_buffer_blocksize);
+    if (copy_size)
+      memcpy(gamepak_buffers[i], rom + src_offset, copy_size);
+    sf2000_load_progress("ROM_MEM", i + 1, buf_blocks);
+
+    for (j = 0; j < 32 && i * 32 + j < rom_blocks; j++)
+    {
+      u32 phyn = i * 32 + j;
+      u8 *blkptr = &gamepak_buffers[i][32 * 1024 * j];
+      u32 entry = evict_gamepak_page();
+      gamepak_blk_queue[entry].phy_rom = phyn;
+      map_rom_entry(read, phyn, blkptr, rom_blocks);
+    }
+  }
+
+  return 0;
+}
+
 u32 load_gamepak(const struct retro_game_info* info, const char *name,
                  int force_rtc, int force_rumble, int force_serial)
 {
    char game_code[5] = {0,0,0,0,0};
 
-   if (load_gamepak_raw(name))
+   sf2000_load_progress("GPSP_GAMEPAK", 1, 3);
+   if (info && info->data && info->size)
+   {
+      if (load_gamepak_memory(info))
+         return -1;
+   }
+   else if (load_gamepak_raw(name))
       return -1;
 
    // Buffer 0 always has the first 1MB chunk of the ROM
@@ -2555,6 +2619,7 @@ u32 load_gamepak(const struct retro_game_info* info, const char *name,
    backup_type_reset = BACKUP_UNKN;
    serial_mode = force_serial;
 
+   sf2000_load_progress("GPSP_GAMEPAK_CONFIG", 2, 3);
    load_game_config_over(game_code);
 
    // Forced RTC / Rumble modes, override the autodetect logic.
@@ -2563,6 +2628,7 @@ u32 load_gamepak(const struct retro_game_info* info, const char *name,
    if (force_rumble != FEAT_AUTODETECT)
       rumble_enabled = (force_rumble == FEAT_ENABLE);
 
+   sf2000_load_progress("GPSP_GAMEPAK_DONE", 3, 3);
    return 0;
 }
 
