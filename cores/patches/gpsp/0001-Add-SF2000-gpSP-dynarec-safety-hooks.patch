+   sf2000_load_progress("GPSP_LOAD_GAMEPAK_OK", 4, 7);
 
    struct retro_rumble_interface rumbleif;
    if (environ_cb(RETRO_ENVIRONMENT_GET_RUMBLE_INTERFACE, &rumbleif))
@@ -1143,10 +1151,13 @@ bool retro_load_game(const struct retro_game_info* info)
    else
       rumble_cb = NULL;
 
+   sf2000_load_progress("GPSP_LOAD_RESET", 5, 7);
    reset_gba();
 
+   sf2000_load_progress("GPSP_LOAD_MEMDESC", 6, 7);
    set_memory_descriptors();
 
+   sf2000_load_progress("GPSP_LOAD_OK", 7, 7);
    return true;
 }
 
