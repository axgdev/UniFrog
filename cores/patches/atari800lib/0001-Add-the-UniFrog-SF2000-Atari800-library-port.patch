diff --git a/Makefile b/Makefile
index a88403cffdacc530f2b414b1e778f699bf642f60..50d413e134363c7d7ba4fad97b4d4fe001df9b7a 100644
--- a/Makefile
+++ b/Makefile
@@ -220,6 +220,19 @@ else ifeq ($(platform), vita)
    PLATFORM_DEFINES := -DVITA
    STATIC_LINKING = 1
 
+else ifeq ($(platform), sf2000)
+    TARGET := $(TARGET_NAME)_libretro_$(platform).a
+    MIPS=/opt/mips32-mti-elf/2019.09-03-2/bin/mips-mti-elf-
+    CC = $(MIPS)gcc
+    CXX = $(MIPS)g++
+    AR = $(MIPS)ar
+    CFLAGS =-EL -march=mips32 -mtune=mips32 -msoft-float -ffast-math -fomit-frame-pointer
+    CFLAGS+=-G0 -mno-abicalls -fno-pic
+#	-ffreestanding
+    CFLAGS+=-DSF2000
+    CXXFLAGS=$(CFLAGS)
+    STATIC_LINKING = 1
+
 # CTR (3DS)
 else ifeq ($(platform), ctr)
 	EXT=a
