From ec6b180db167818a124ddf0c62478653f53d296b Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Thu, 7 May 2026 02:48:57 +0000
Subject: [PATCH] Guard SF2000 sysconf stub constant

Only define the Xvid SF2000 _SC_NPROCESSORS_CONF fallback when the C library has not already provided it. This preserves the local sysconf stub and avoids a newlib macro redefinition warning.
---
 xvid/portab.h | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/xvid/portab.h b/xvid/portab.h
index bffc9f0..a0bc613 100644
--- a/xvid/portab.h
+++ b/xvid/portab.h
@@ -56,9 +56,11 @@
 #define pthread_num_processors_np() (1)
 #define sched_yield() ((void)0)
 
-/* Stub sysconf for SF2000 */
-#define _SC_NPROCESSORS_CONF 0
-#define sysconf(x) (1)
+/* Stub sysconf for SF2000 */
+#ifndef _SC_NPROCESSORS_CONF
+#define _SC_NPROCESSORS_CONF 0
+#endif
+#define sysconf(x) (1)
 
 /* Generic BSWAP (byte swap) */
 #define BSWAP(a) \
-- 
2.54.0

