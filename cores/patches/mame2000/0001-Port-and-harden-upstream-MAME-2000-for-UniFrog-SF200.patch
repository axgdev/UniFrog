+							Machine->orientation ^= ROT180;
+
+					Machine->orientation ^= ROT270;
+					break;
+			}
+			osd_set_rotation_mode(rotation_mode);
+			update_geometry();
+			cpu_set_reset_line(0,PULSE_LINE);
