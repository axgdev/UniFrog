             }
             else if (commandChar == 'c'){
+                if (n + 1 >= length) break;
                 uint8_t colChar = str[++n];
                 uint8_t col = p0CharToNum(colChar);
 
@@ -255,20 +262,25 @@ int print(std::string str, int x, int y, uint8_t c) {
                 homeY = y;
             }
             else if (commandChar == 'j'){
+                if (n + 2 >= length) break;
                 uint8_t xChar = str[++n];
