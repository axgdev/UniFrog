+                if (4 > length - n - 1) break;
                 std::string addrHexStr = str.substr(n+1, 4);
                 n+=4;
-                int addr = (int)strtol(addrHexStr.c_str(), NULL, 16);
+                size_t addr = (size_t)strtoul(addrHexStr.c_str(), NULL, 16);
 
-                int size = length - n;
+                size_t size = length - n - 1;
                 std::string binStr = str.substr(n + 1, size);
-                n+=size;
-
+                size_t available = addr < sizeof(_ph_mem->data) ?
+                    sizeof(_ph_mem->data) - addr : 0;
+                size = std::min(size, available);
                 for(size_t i = 0; i < size; i++) {
                     _ph_mem->data[addr + i] = binStr[i];
                 }
+                n = length - 1;
             }
             else if (commandChar == '@'){
+                if (8 > length - n - 1) break;
                 std::string addrHexStr = str.substr(n+1, 4);
                 n+=4;
-                int addr = (int)strtol(addrHexStr.c_str(), NULL, 16);
+                size_t addr = (size_t)strtoul(addrHexStr.c_str(), NULL, 16);
 
                 std::string sizeHexStr = str.substr(n+1, 4);
                 n+=4;
 
-                int size = (int)strtol(sizeHexStr.c_str(), NULL, 16);
+                size_t size = (size_t)strtoul(sizeHexStr.c_str(), NULL, 16);
