Subject: [PATCH 3/4] Guard PicoDrive FAMEC option

Avoid redefining FAMEC_NO_GOTOS when the UniFrog wrapper already passes the same option on the compiler command line. This keeps the build behavior unchanged while removing the duplicate define warning.
---
 cpu/fame/famec.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/cpu/fame/famec.c b/cpu/fame/famec.c
index b0ee0f0779a885942fe2e9e3dadeb8572634bfa8..10a16825f5517ddd4743d680509c96ce395a1154 100644
--- a/cpu/fame/famec.c
+++ b/cpu/fame/famec.c
@@ -24,7 +24,9 @@
 #define FAMEC_CHECK_BRANCHES
 #define FAMEC_EXTRA_INLINE
 // #define FAMEC_DEBUG
+#ifndef FAMEC_NO_GOTOS
 #define FAMEC_NO_GOTOS
+#endif
 #define FAMEC_ADR_BITS  24
 // #define FAMEC_FETCHBITS 8
 #define FAMEC_DATABITS  8
