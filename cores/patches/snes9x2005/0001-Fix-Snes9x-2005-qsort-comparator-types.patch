From bcc5d8ab689d48358eef7e53a7ef72cdc8512713 Mon Sep 17 00:00:00 2001
From: "Axel Garcia K." <git@axelgk.com>
Date: Tue, 5 May 2026 18:57:44 +0000
Subject: [PATCH] Fix Snes9x 2005 qsort comparator types

Return int from qsort comparators so the code matches the C library ABI used by HCRTOS newlib.
---
 source/clip.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/source/clip.c b/source/clip.c
index db68e1e..bf5a26b 100644
--- a/source/clip.c
+++ b/source/clip.c
@@ -26,12 +26,12 @@ typedef struct
     R.Right = MIN(A.Right, B.Right); \
 }
 
-static int32_t IntCompare(const void* d1, const void* d2)
+static int IntCompare(const void* d1, const void* d2)
 {
    return *(uint32_t*) d1 - *(uint32_t*) d2;
 }
 
-static int32_t BandCompare(const void* d1, const void* d2)
+static int BandCompare(const void* d1, const void* d2)
 {
    return ((Band*) d1)->Left  - ((Band*) d2)->Left;
 }
