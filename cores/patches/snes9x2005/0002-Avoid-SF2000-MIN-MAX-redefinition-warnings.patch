From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UniFrog CI <ci@unifrog.local>
Date: Thu, 7 May 2026 02:51:08 +0000
Subject: [PATCH 2/2] Avoid SF2000 MIN MAX redefinition warnings

Undefine MIN and MAX from the HCRTOS/newlib limits wrapper before Snes9x 2005 installs its local helpers. This keeps the core's existing macro semantics while removing repeated preprocessor warnings from every translation unit.
---
 source/port.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/source/port.h b/source/port.h
index 5defb769b1e344051781a9c17e2b64fdc0ef5194..e52eaa2d00eff017669805635a79885dac4d69a8 100644
--- a/source/port.h
+++ b/source/port.h
@@ -62,6 +62,12 @@
 #include <libretro.h>
 
 #define ABS(X)   ((X) <  0  ? -(X) : (X))
+#ifdef MIN
+#undef MIN
+#endif
+#ifdef MAX
+#undef MAX
+#endif
 #define MIN(A,B) ((A) < (B) ?  (A) : (B))
 #define MAX(A,B) ((A) > (B) ?  (A) : (B))
 
