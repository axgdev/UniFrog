+static BOOL js_int_add_overflow(int a, int b, int *pr)
+{
+    if ((b > 0 && a > INT_MAX - b) ||
+        (b < 0 && a < INT_MIN - b))
+        return TRUE;
+    *pr = a + b;
+    return FALSE;
+}
+
+static BOOL js_int_sub_overflow(int a, int b, int *pr)
+{
+    if ((b < 0 && a > INT_MAX + b) ||
+        (b > 0 && a < INT_MIN + b))
+        return TRUE;
+    *pr = a - b;
+    return FALSE;
+}
